#include <stdio.h>

float sayi=0;

void main()
{
    printf("Sayiyinin isaretini sorgulamak icin sayıyı giriniz:");
    scanf("%f", &sayi);
    
    //sayı sorgulamasını yapar
    if (sayi>0)
    {
        
        printf("Sayiniz pozitif degerlidir");
        
    }
    
    else if (sayi<0)
    {
        
        printf("Sayiniz negatif degerlidir");
        
    }
    
    else
    
        printf("Sayiniz 0 dir");
    
    
    
}
